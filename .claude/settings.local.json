{
  "permissions": {
    "allow": [
      "mcp__acp__Bash",
      "mcp__acp__Write",
      "mcp__acp__Edit"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/node-typescript/quality-check.js"
          }
        ]
      }
    ]
  }
}
